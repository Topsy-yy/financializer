PORT=8080
APP_BASE_URL=http://localhost:8080
MOCK_REQUIRED_INTEGRATIONS=true
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
SESSION_SECRET=replace_with_a_random_long_string
# Advanced/optional: only set this if you're routing through your own custom
# proxy that already returns data in FinGuard's internal shape. Leave unset to
# use the real Zoho Books API (via ZOHO_OAUTH_* below) or mock/demo data.
# ZOHO_DIRECT_API_URL=
ZOHO_OAUTH_CLIENT_ID=replace_with_zoho_client_id
ZOHO_OAUTH_CLIENT_SECRET=replace_with_zoho_client_secret
ZOHO_OAUTH_AUTH_URL=https://accounts.zoho.com/oauth/v2/auth
ZOHO_OAUTH_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_OAUTH_SCOPE=ZohoBooks.fullaccess.all
ZOHO_OAUTH_REDIRECT_URI=http://localhost:8080/api/oauth/zoho/callback
CORE_WALLET_API_URL=https://your-core-wallet-endpoint.example.com/wallet
CORE_WALLET_API_KEY=replace_with_wallet_token
CORE_WALLET_ACCOUNT_ID=wallet-account-001
AVALANCHE_WALLET_ADDRESS=avax1examplewalletaddress
AVALANCHE_WALLET_API_KEY=replace_with_avalanche_wallet_token
BUSINESS_NAME=K-Biz Holdings
USER_NAME=Aisha Mwangi
BUSINESS_ADDRESS=Nairobi, Kenya
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_MODEL=gpt-5-mini
AI_API_TIMEOUT_MS=15000
ENABLE_AI_ANALYSIS=true
BUSINESS_OWNER_KEYWORDS=owner,personal,mpesa-self,home-rent
ALERT_EMAILS=founder@company.com,accountant@company.com
AVALANCHE_CLI_PATH=avalanche
ENABLE_AVALANCHE=false
AVALANCHE_CCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CCHAIN_CHAIN_ID=43113
AVALANCHE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_DEPLOY_PRIVATE_KEY=replace_with_deployer_private_key
AVALANCHE_CONTRACT_ALLOWLIST=TreasuryGuard,InvoiceVault
ENABLE_AVALANCHE_CONTRACT_DEPLOY=false
