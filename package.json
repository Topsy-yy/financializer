{
  "name": "ai-financial-controller-skill-app",
  "version": "0.1.0",
  "description": "Skills-based FinGuard AI for Kenyan SMEs",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:contracts": "node scripts/compile-contracts.js",
    "postinstall": "node scripts/compile-contracts.js",
    "lint": "echo \"No linter configured yet\"",
    "test": "node --test \"tests/ai/*.test.js\" \"tests/domain/*.test.js\" \"tests/golden/*.test.js\" \"tests/ingestion/*.test.js\" \"tests/security/*.test.js\" \"tests/ops/*.test.js\"",
    "test:baseline": "node --test \"tests/golden/*.test.js\"",
    "test:security": "node --test \"tests/security/*.test.js\"",
    "secrets:scan": "node scripts/scan-secrets.js",
    "test:db": "node --test --test-concurrency=1 \"tests/db/*.test.js\"",
    "db:migrate": "node src/db/migrate.js",
    "test:http": "node --test --test-concurrency=1 \"tests/http/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:db && npm run test:http && npm run test:e2e",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "test:bootstrap": "node --test --test-concurrency=1 \"tests/db/bootstrap.test.js\"",
    "verify:paystack": "node scripts/verify-paystack.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "solc": "^0.8.36"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
